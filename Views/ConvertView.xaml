<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" mc:Ignorable="av"
             x:Class="GnuConvert.Views.ConvertView"
             Height="auto" Width="Auto"
               DataContext="{StaticResource ConvertVM}">
    <Grid Background="#FFF5F3EE" Width="auto" MinWidth="1000" MinHeight="1000">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,200,0,100">
            <TextBlock Text="Ez a felület a bank könyvelést fogja segíteni!" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" Foreground="#FF4D4335" />
            <TextBlock Text="Röviden és egyszerűen megmutatj a program működését." 
               FontSize="16" TextAlignment="Center" Margin="0,0,0,30" Foreground="#FF4D4335" />
            <TextBlock Text=""/>
        </StackPanel>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Width="1000" Height="345" Grid.Row="4" Margin="0,400,0,0">
            <Label x:Name="label" Content="Banki fökönyvi szám" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FF4D4335" Margin="200,0,0,10" FontFamily="Century Schoolbook" FontWeight="Bold" FontSize="14"/>
            <TextBox x:Name="textBox" Text="{Binding BankiFokonyviszam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TextWrapping="Wrap"  VerticalAlignment="Center" Width="132" Height="25" Margin="200,0,0,30" FontSize="14" Padding="2,2,2,2"/>

            <Button x:Name="Fokonyvbutton" Content="Pénzügyi Nyilvántartás" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" Padding="10,1,10,1" ScrollViewer.CanContentScroll="True" Panel.ZIndex="5" FontSize="14" Click="button_Click" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Margin="200,0,0,30"/>
            <Button x:Name="KonvertalasButton" Content="Konvertálás" HorizontalAlignment="Left" VerticalAlignment="Center" Height="40" RenderTransformOrigin="0.477,0.553" Padding="10,1,10,1" FontSize="14" Click="KonvertalasButton_Click" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Margin="200,0,0,30"/>

        </StackPanel>
    </Grid>
</UserControl>