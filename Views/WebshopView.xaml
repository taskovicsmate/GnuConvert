<UserControl x:Class="GnuConvert.Views.WebshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Height="Auto" Width="Auto">

    <Grid Background="#FFF5F3EE">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="599" MinHeight="400">
            <TextBlock Text="Ez a felület a webshopok könyvelését fogja segíteni!" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" FontFamily="Century Schoolbook" Foreground="#FF4D4335" />
            <TextBlock Text="Röviden és egyszerűen megmutatja a program működését." 
           FontSize="16" TextAlignment="Center" Margin="0,0,0,30" FontFamily="Century Schoolbook" Foreground="#FF4D4335" />
            <TextBlock Text=""/>
        </StackPanel>
            <Button x:Name="button" Content="Főkönyvszámok beolvasása" Height="40" Padding="10,1,10,1"  FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="100,0,0,60" Style="{DynamicResource ButtonStyle2}" FontFamily="Century Schoolbook" Background="#FF8A6240" Foreground="#FFF5F3EE"/>
            <Button x:Name="button_Copy" Content="Konvertálás" Height="40"  Padding="10,1,10,1" FontSize="14" Margin="0,0,100,60" Width="NaN" VerticalContentAlignment="Center" MinHeight="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Click="button_Copy_Click" Style="{DynamicResource ButtonStyle2}" FontFamily="Century Schoolbook" Background="#FF8A6240" Foreground="#FFF5F3EE" BorderBrush="{x:Null}"/>
    </Grid>
</UserControl>

