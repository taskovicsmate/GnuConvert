<UserControl x:Class="GnuConvert.Views.WebshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              Height="Auto" Width="Auto"
              DataContext="{DynamicResource WebshopVM}">
    <Grid Background="#FFF5F3EE" Width="auto" MinWidth="1000" MinHeight="1000" Height="700">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,50,0,100">
            <TextBlock Text="Ez a felület a Webshop könyvelést fogja segíteni!" FontSize="26" FontWeight="Bold" Margin="0,0,0,20" Foreground="#FF4D4335" FontFamily="Century Schoolbook" />
            <TextBlock Text="Röviden és egyszerűen megmutatj a program működését." 
        FontSize="16" TextAlignment="Center" Margin="0,0,0,30" Foreground="#FF4D4335" FontFamily="Century Schoolbook" />
            <TextBlock FontSize="16"
           Text="{Binding CurrentSubView}"
           Margin="20"
           Panel.ZIndex="999"/>

        </StackPanel>
        <StackPanel VerticalAlignment="Top">
            <Border BorderThickness="0,3,0,3" Margin="0,200,0,0" Padding="0,10,0,10" Panel.ZIndex="3">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FF2F4A36" Opacity="0.8"/>
                </Border.BorderBrush>
                <Grid >
                    <Label x:Name="label2" Content="Partner választás" Panel.ZIndex="0" SnapsToDevicePixels="True" Margin="30,-47,0,0" AllowDrop="True" FontFamily="Century Schoolbook" VerticalAlignment="Top" FontSize="20" FontWeight="Bold" Foreground="#FFF5F3EE" HorizontalAlignment="Left">
                        <Label.Background>
                            <SolidColorBrush Color="#FF2F4A36" Opacity="0.8"/>
                        </Label.Background>
                    </Label>
                    <Label x:Name="label1" Content="Válasszon egy partnert:" HorizontalAlignment="Left" Panel.ZIndex="5" SnapsToDevicePixels="True" Margin="350,0,0,0" AllowDrop="True" FontFamily="Century Schoolbook" VerticalAlignment="Center" Foreground="#FF4D4335" FontSize="14" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Partners}"
   SelectedItem="{Binding SelectedPartner, Mode=TwoWay}"
   DisplayMemberPath="Name" MinWidth="200" FontSize="14" FontWeight="Bold" FontFamily="Century Schoolbook" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="550,0,0,0"/>
                    <Button x:Name="PartnerButton" Command="{Binding ShowAddPartnerCommand}" Content="Partner hozzáadása" Padding="10,1,10,1" ScrollViewer.CanContentScroll="True" Panel.ZIndex="5" FontSize="14" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Margin="175,10,0,10" HorizontalAlignment="Left" Height="30" VerticalAlignment="Center"/>
                    <Button x:Name="DeletePartner" Content="Partner törlése"  Command="{Binding DeletePartnerCommand}" HorizontalAlignment="Right" Height="40" RenderTransformOrigin="0.477,0.553" Padding="10,1,10,1" FontSize="14" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Width="130" Margin="0,0,51,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Orientation="Vertical" Grid.Row="4" Margin="0,200,0,0" MinWidth="1000" MinHeight="1000" >
            <Border BorderThickness="0,3,0,3" Margin="0,150,0,0" Padding="0,30,0,30" Panel.ZIndex="5">
                <Border.BorderBrush>
                    <SolidColorBrush Color="#FF2F4A36" Opacity="0.8"/>
                </Border.BorderBrush>
                <Grid>

                    <Label x:Name="label3" Content="Webshop Konvertálás" SnapsToDevicePixels="True" Margin="30,-67,0,0" AllowDrop="True" FontFamily="Century Schoolbook" VerticalAlignment="Top" FontSize="20" FontWeight="Bold" Foreground="#FFF5F3EE" HorizontalAlignment="Left">
                        <Label.Background>
                            <SolidColorBrush Color="#FF2F4A36" Opacity="0.8"/>
                        </Label.Background>
                    </Label>

                    <Label x:Name="label" Content="Banki fökönyvi szám" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF4D4335" Margin="175,10,0,0" FontFamily="Century Schoolbook" FontWeight="Bold" FontSize="14" Height="27" Width="162"/>
                    <TextBox x:Name="textBox" Text="{Binding BankiFokonyviszam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Left" TextWrapping="Wrap"  VerticalAlignment="Top" Width="132" Height="25" Margin="360,12,0,0" FontSize="14" Padding="2,2,2,2" FontFamily="Century Schoolbook"/>

                    <Button x:Name="Fokonyvbutton" Content="Pénzügyi Nyilvántartás" Command="{Binding InvoiceFilePathCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" Padding="10,1,10,1" ScrollViewer.CanContentScroll="True" Panel.ZIndex="0" FontSize="14" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Margin="175,74,0,0" Width="176"/>
                    <Button x:Name="KonvertalasButton" Content="Bank kiválasztása"  Command="{Binding BankFilePathCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" RenderTransformOrigin="0.477,0.553" Padding="10,1,10,1" FontSize="14" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Margin="175,145,0,0" Width="146"/>
                    <Button x:Name="BankButton" Content="Konvertálás"  Command="{Binding ConvertDataCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="40" RenderTransformOrigin="0.477,0.553" Padding="10,1,10,1" FontSize="14" Style="{DynamicResource ButtonStyle2}" Background="#FF8A6240" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" Margin="175,200,0,0" Width="101"/>
                    <CheckBox x:Name="checkBox" HorizontalAlignment="Left" Margin="368,87,0,0" VerticalAlignment="Top" IsChecked="{Binding IsInvoiceFileChosen}"
                       IsHitTestVisible="False" Focusable="False"/>
                    <CheckBox x:Name="checkBox2" HorizontalAlignment="Left" Margin="333,160,0,0" VerticalAlignment="Top" IsChecked="{Binding IsBankFileChosen}"
                       IsHitTestVisible="False" Focusable="False"/>
                 

                </Grid>
            </Border>
        </StackPanel>

        <ContentControl Content="{Binding CurrentSubView}"  RenderTransformOrigin="0.5,0.5" Panel.ZIndex="14" DockPanel.Dock="Top" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" MinWidth="100" MinHeight="100" />
    </Grid>

</UserControl>

