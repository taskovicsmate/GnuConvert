<UserControl DataContext="{DynamicResource FokonyvVM}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="av"
            x:Class="GnuConvert.Views.KonyveloknekSettingsView"
             Height="Auto" Width="Auto"
    >


    <Grid Background="#FFF5F3EE">
        <StackPanel >
            <TextBlock Text="Könyvelőknek szükséges alapbeállítások." FontSize="36" FontWeight="Bold" Margin="50,50,0,20" HorizontalAlignment="Left" Foreground="#FF4D4335" FontFamily="Century Schoolbook" />
            <Grid>
                <Label x:Name="label" Content="Mentés helyének kiválasztása" FontWeight="Bold" FontSize="22" BorderThickness="0,0,0,3" HorizontalAlignment="Left" Margin="150,0,0,0" Foreground="#FF4D4335" FontFamily="Century Schoolbook" FontStyle="Italic"/>
                <Button x:Name="InfoButton2" Content="I"
            Width="20" Height="20"
            MouseEnter="Button_MouseEnter2"
            MouseLeave="Button_MouseLeave2" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Click="Button_Click" Margin="498,0,0,0" SnapsToDevicePixels="True" FontFamily="Century Schoolbook" FontWeight="Bold" Background="#FF8A6240" Foreground="#FFF5F3EE">
                    <Button.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Button.LayoutTransform>
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0"/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>
            </Grid>
            <Canvas>

                <TextBlock x:Name="Info2"  Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Height="55" Canvas.Left="533" Width="243" Background="#FF8CD97F" Padding="10,10,10,9" SnapsToDevicePixels="True" TextWrapping="WrapWithOverflow" Canvas.Top="-44"><Run Text="A"/><Run Language="hu-hu" Text=" program a kiválasztott mappába fogja menteni a konvertált fájlokat."/></TextBlock>
            </Canvas>
            <Grid HorizontalAlignment="Left" Margin="150,0,0,0" Width="940" >
                <Button x:Name="button" Content="Convertált számlák helye" Command="{Binding SelectFolderCommand}" HorizontalAlignment="Left" Height="40" Margin="50,20,20,20" Padding="10,10,10,10" ScrollViewer.CanContentScroll="True" FontSize="14" Style="{DynamicResource ButtonStyle2}" Foreground="#FFF5F3EE" FontFamily="Century Schoolbook" BorderBrush="{x:Null}">
                    <Button.Background>
                        <SolidColorBrush Color="#FF8A6240"/>
                    </Button.Background>
                </Button>
                <Label x:Name="label1" Content="{Binding SelectedFolderPath}" Margin="300,25,205,25" Background="#FFCABA9C" Width="auto" Height="30" VerticalContentAlignment="Center" FontSize="16" Foreground="#FFF5F3EE"/>

            </Grid>

            <Grid HorizontalAlignment="Left" Margin="150,0,0,0" Width="940">

                <Button x:Name="button1" Content="Kivételes számlák helye"  Command="{Binding SelectExceptionFolderCommand}" HorizontalAlignment="Left" Height="40" Margin="50,20,20,20" Padding="10,10,10,10" FontSize="14" Style="{DynamicResource ButtonStyle2}" Foreground="#FFF5F3EE" Background="#FF8A6240" FontFamily="Century Schoolbook" BorderBrush="{x:Null}"/>
                <Label x:Name="label1_Copy" Content="{Binding SelectedExceptionFolderPath}" Margin="300,25,205,25" Background="#FFCABA9C" Width="auto" Height="30" VerticalContentAlignment="Center" FontSize="16" Foreground="#FFF5F3EE"/>

            </Grid>
            <Grid>
                <Label x:Name="label_Copy" Content="Konvertálás beállításai" FontWeight="Bold" FontSize="22" Margin="150,0,0,0" HorizontalAlignment="Left" ClipToBounds="True" BorderBrush="Black" Height="40" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontStyle="Italic" Foreground="#FF4D4335" FontFamily="Century Schoolbook"/>
                <Button x:Name="InfoButton" Content="I"
                        Width="20" Height="20"
                        MouseEnter="Button_MouseEnter"
                        MouseLeave="Button_MouseLeave" HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Click="Button_Click" Margin="431,0,0,0" FontFamily="Century Schoolbook" FontWeight="Bold" Background="#FF8A6240" Foreground="#FFF5F3EE">
                    <Button.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Button.LayoutTransform>
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform X="0"/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>
            </Grid>
            <Canvas>

                <TextBlock x:Name="Info"  Visibility="Collapsed"  HorizontalAlignment="Left" VerticalAlignment="Top" Height="90" Canvas.Left="460" Width="250" Background="#FF8CD97F" Padding="10,10,10,9" SnapsToDevicePixels="True" TextWrapping="WrapWithOverflow" Canvas.Top="-25"><Run Text="Az alábbi beállítási funkciók lehetőséget adnak, hogy tetszés szerint lehe"/><Run Language="hu-hu" Text="ssen"/><Run Text=" a konvertált állományban található bizonylatszám"/><Run Language="hu-hu" Text=" cella tartalmát"/><Run Text=" "/><Run Text="testreszabni."/></TextBlock>
            </Canvas>

            <Grid Margin="150,0,0,0" HorizontalAlignment="Left" Width="940" >
                <StackPanel>
                    <Grid>

                        <RadioButton x:Name="radioButton" Checked="RadioButton_Checked" GroupName="BizonylatszamValasztas" Content="Dátum" HorizontalAlignment="Left" Margin="100,20,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="14" Padding="4,0,0,0" Foreground="#FF4D4335" FontFamily="Century Schoolbook"/>
                        <RadioButton x:Name="radioButton2" Checked="RadioButton_Checked" GroupName="BizonylatszamValasztas" Content="Üres" HorizontalAlignment="Left" Margin="100,60,0,0" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Foreground="#FF4D4335" FontFamily="Century Schoolbook"/>
                        <RadioButton x:Name="radioButton3" Checked="RadioButton_Checked"  GroupName="BizonylatszamValasztas" Content="Egyéb szabadon választható" HorizontalAlignment="Left" Margin="100,100,0,0" VerticalAlignment="Bottom" Height="30" FontSize="14" FontWeight="Bold" Foreground="#FF4D4335" FontFamily="Century Schoolbook"/>
                        <TextBox x:Name="KiEgyBizonylatSzam" TextWrapping="Wrap" RenderTransformOrigin="0.486,0.505" Margin="361,85,277,15" Height="30" VerticalContentAlignment="Center" UseLayoutRounding="True" FontWeight="Bold" Visibility="Collapsed"/>

                    </Grid>
                    <Grid/>




                </StackPanel>

            </Grid>
            <Grid  Margin="150,0,0,0" HorizontalAlignment="Left" Width="940" >

                <Button x:Name="button3" Content="Fökönyvi számok beolvasása" Command="{Binding SelectFokonyvFileCommand}" HorizontalAlignment="Left" Height="40" Margin="50,20,20,20" Padding="10,10,10,10" FontSize="14" Style="{DynamicResource ButtonStyle2}" Foreground="#FFF5F3EE" Background="#FF8A6240" FontFamily="Century Schoolbook" BorderBrush="{x:Null}"/>
                <Label x:Name="label1_Copy1" Content="{Binding SelectFokonyvFilePath}" Margin="300,25,205,25" Background="#FFCABA9C" Width="auto" Height="30" VerticalContentAlignment="Center" FontSize="16" Foreground="#FFF5F3EE"/>
            </Grid>
            <Grid Height="175">
                <Button x:Name="button2" Style="{DynamicResource ButtonStyle2}" Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Margin="926,0,0,0" VerticalAlignment="Center" Width="67" Height="31" Background="#FF7A8F7A" Foreground="#FFF5F3EE" BorderBrush="{x:Null}" FontWeight="Bold" FontSize="14" FontFamily="Century Schoolbook"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>

