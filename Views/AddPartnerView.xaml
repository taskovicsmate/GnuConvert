<UserControl x:Class="GnuConvert.Views.AddPartnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GnuConvert.Views"
             mc:Ignorable="d">
    <Border BorderBrush="Black" BorderThickness="1" Width="1000" Height="500">
        <Grid Background="#FFF5F3EE" RenderTransformOrigin="0.445,0.492" Width="1100" Margin="0,0,-102,-246" Height="750" >
            <TextBlock Text="Új partner hozzáadása" FontSize="26" FontWeight="Bold" Margin="10,10,518,454" Foreground="#FF4D4335" />
            <TextBlock FontSize="16" Margin="10,57,518,414" Foreground="#FF4D4335" ><Run Text="Adja meg a partner nevét és a"/><Run Language="hu-hu" Text=" tételelkhez"/><Run Text=" tartozó főkönyvi számot."/></TextBlock>
            <Label x:Name="label" Content="Partner neve:" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top" FontSize="14"/>
            <TextBox x:Name="textBox"  TextWrapping="Wrap" FontSize="14" Padding="2,2,2,2" Margin="109,105,823,615" RenderTransformOrigin="0.5,0.5"/>
            <Label x:Name="label2" Content="Minden tételhez írja mellé az ön által eddig használt főkönyvi számot." HorizontalAlignment="Left" Margin="10,223,0,0" VerticalAlignment="Top" FontSize="14"/>
            <Button x:Name="button2" Content="Nyilvántartás kiválasztása" HorizontalAlignment="Left" Margin="10,167,0,0" VerticalAlignment="Top" FontSize="14"/>
            <Button x:Name="button3" Content="Banktörténet kiválasztása" HorizontalAlignment="Left" Margin="10,198,0,0" VerticalAlignment="Top" FontSize="14"/>
            <CheckBox x:Name="checkBox" HorizontalAlignment="Left" Margin="175,171,0,0" VerticalAlignment="Top"/>
            <CheckBox x:Name="checkBox2" HorizontalAlignment="Left" Margin="175,203,0,0" VerticalAlignment="Top"/>
            <Label x:Name="label3" Content="Válassza ki a partneréhez tartozó megfelelő fájlokat." HorizontalAlignment="Left" Margin="10,131,0,0" VerticalAlignment="Top" FontSize="14"/>

            <DataGrid ItemsSource="{Binding Rows}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="False" Margin="0,260,10,77">

                <DataGrid.Columns>
                    <!-- Read-only oszlopok -->
                    <DataGridTextColumn Header="PartnerName"
                            Binding="{Binding PartnerName}"
                            IsReadOnly="True"/>

                    <DataGridTextColumn Header="Kozlemeny"
                            Binding="{Binding Kozlemeny}"
                            IsReadOnly="True"/>

                    <DataGridTextColumn Header="Ar"
                            Binding="{Binding Price}"
                            IsReadOnly="True"/>

                    <!-- Editálható utolsó oszlop -->
                    <DataGridTextColumn Header="Felhasználó főkönyvi szám"
                            Binding="{Binding UserLedger, UpdateSourceTrigger=PropertyChanged}"
                            IsReadOnly="False"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button x:Name="button" Content="Konvertáló Bentanítása" HorizontalAlignment="Left" Margin="888,678,0,0" VerticalAlignment="Top" Style="{DynamicResource ButtonStyle2}" FontSize="14"/>

        </Grid>
    </Border>
</UserControl>
