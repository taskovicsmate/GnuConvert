<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             x:Class="GnuConvert.Views.GeneralSettingsView"
             Height="Auto" Width="Auto">

    <Grid MinHeight="826" MinWidth="1090" >
        <Grid.Background>
            <SolidColorBrush Color="#FFF5F3EE" Opacity="0.85"/>
        </Grid.Background>
        <StackPanel MinHeight="825" MinWidth="1090" Height="825" Background="#FFF5F3EE">
            <Grid Height="110">
                <TextBlock Text="Általános beállítások" FontSize="36" FontWeight="Bold" Margin="50,50,0,20" HorizontalAlignment="Left" VerticalAlignment="Top" Height="47" Foreground="#FF4D4335" FontFamily="Century Schoolbook" />

            </Grid>
            <Grid HorizontalAlignment="Left" Margin="150,0,0,10" Width="auto">
                <Grid.RowDefinitions>
                    <RowDefinition Height="33*"/>
                    <RowDefinition Height="14*"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="22" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="5,5,5,5" ScrollViewer.CanContentScroll="True" FontFamily="Century Schoolbook" Foreground="#FF4D4335" ><Run Language="hu-hu" Text="Nyelv"/></TextBlock>
                <ComboBox x:Name="comboBox" Margin="259,10,10,7" Width="200" Height="25"/>


            </Grid>
            <Grid HorizontalAlignment="Left" Margin="150,0,0,0" Width="auto">
                <TextBlock Text="Megjelenés " FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Padding="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="Century Schoolbook" Foreground="#FF4D4335" />
                <ComboBox x:Name="comboBox1" HorizontalAlignment="Left" Margin="259,14,0,0" VerticalAlignment="Top" Width="200" Height="25"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>

