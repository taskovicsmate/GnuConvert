<UserControl x:Class="GnuConvert.Views.FooldalView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F5F2EC"
            Height="Auto" Width="Auto">

    <!--
      DataContext (példa property/command nevek):
        - StartBankConversionCommand : ICommand
        - SendFeedbackCommand : ICommand
        - LastConversionDate : string
        - LastPartnerName : string
        - LastTransactionCount : int
        - MonthProcessedCount : int
        - AutoMatchRate : double (0..100)
        - SubscriptionStatus : string
        - MissingMappingWarning : string
        - AppVersion : string
        - RecentConversions : IEnumerable<RecentConversionItem>
            - PartnerName : string
            - Date : string
            - Count : int
            - Status : string
            - OpenCommand : ICommand  (vagy használd a listás OpenConversionCommand + CommandParameter)
    -->

    <UserControl.Resources>
        <!-- Typography -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3B2E22"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#5A4A3A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3B2E22"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#6B5A48"/>
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3B2E22"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#7A573A"/>
            <Setter Property="BorderBrush" Value="#6A4B33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3B2E22"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CDBFAE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2D8CC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Simple divider -->
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#E7DED2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Hero -->
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <!-- Cards -->
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <!-- Recent -->
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <!-- Feedback -->
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- HERO -->
            <Border Grid.Row="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Style="{StaticResource H1}"
                               Text="Gnu Convert – Automatizált könyvelési konverzió"/>

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource Sub}"
                               Text="Bank és webshop tranzakciók gyors és pontos feldolgozása RLB kompatibilis formátumba." />

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding GoToConvertCommand}"
                                Content="ÚJ BANK KONVERTÁLÁS INDÍTÁSA" Width="250" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STAT CARDS -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card 1 -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Utolsó konvertálás"/>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>
                        <TextBlock Style="{StaticResource Label}" Text="Dátum"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding LastConversionDate}"/>
                        <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" Text="Partner"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#3B2E22"
                                   Text="{Binding LastPartnerName}"/>
                        <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" Text="Tranzakciók"/>
                        <TextBlock FontSize="14" Foreground="#3B2E22" Text="{Binding LastTransactionCount}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Havi teljesítmény"/>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>
                        <TextBlock Style="{StaticResource Label}" Text="Feldolgozott tranzakciók"/>
                        <TextBlock Style="{StaticResource Value}" Text="{Binding MonthProcessedCount}"/>
                        <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" Text="Automatikus párosítás"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#2E6B3B"
                                   Text="{Binding AutoMatchRate, StringFormat={}{0:0.##}%}"/>
                        <TextBlock Margin="0,10,0,0" Foreground="#6B5A48" FontSize="13"
                                   Text="Cél: minél több automatikus párosítás, minél kevesebb kézi javítás."/>
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Rendszer állapot"/>
                        <Border Style="{StaticResource Divider}" Margin="0,12,0,12"/>

                        <TextBlock Style="{StaticResource Label}" Text="Előfizetés"/>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#3B2E22"
                                   Text="{Binding SubscriptionStatus}"/>

                        <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" Text="Figyelmeztetések"/>
                        <Border Background="#FFF6E6" BorderBrush="#E8C78D" BorderThickness="1"
                                CornerRadius="10" Padding="12" Margin="0,6,0,0">
                            <TextBlock Foreground="#6A4B00" FontSize="13"
                                       Text="{Binding MissingMappingWarning}"/>
                        </Border>

                        <TextBlock Style="{StaticResource Label}" Margin="0,12,0,0" Text="Verzió"/>
                        <TextBlock FontSize="13" Foreground="#6B5A48" Text="{Binding AppVersion}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RECENT -->
            <Border Grid.Row="4" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Legutóbbi konvertálások"/>

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding RecentConversions}"
                              BorderThickness="0"
                              Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAF8F4"
                                        BorderBrush="#E7DED2"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#3B2E22"
                                                       Text="{Binding PartnerName}"/>
                                            <TextBlock FontSize="12" Foreground="#6B5A48"
                                                       Text="Partner"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="14" Foreground="#3B2E22"
                                                       Text="{Binding Date}"/>
                                            <TextBlock FontSize="12" Foreground="#6B5A48"
                                                       Text="Dátum"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock FontSize="14" Foreground="#3B2E22"
                                                       Text="{Binding Count}"/>
                                            <TextBlock FontSize="12" Foreground="#6B5A48"
                                                       Text="Tétel"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock FontSize="14" Foreground="#3B2E22"
                                                       Text="{Binding Status}"/>
                                            <TextBlock FontSize="12" Foreground="#6B5A48"
                                                       Text="Állapot"/>
                                        </StackPanel>

                                        <!-- Ha nincs item-szintű commandod, cseréld erre:
                                             Command="{Binding DataContext.OpenConversionCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                             CommandParameter="{Binding}" -->
                                        <Button Grid.Column="4"
                                                Style="{StaticResource GhostButton}"
                                                Content="Megnyitás"
                                                Command="{Binding OpenCommand}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- FEEDBACK BAR -->
            <Border Grid.Row="6"
                    Background="#EFE7DD"
                    BorderBrush="#E2D8CC"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#3B2E22"
                                   ><Run Text="Talált hibát vagy"/><Run Language="hu-hu" Text=" szüksége lenne egy"/><Run Text=" hiányz"/><Run Language="hu-hu" Text="ó"/><Run Text=" funkció"/><Run Language="hu-hu" Text="ra"/><Run Text="?"/></TextBlock>
                        <TextBlock FontSize="13" Foreground="#6B5A48"
                                   Text="Küldj visszajelzést – a program verzióját és alap naplót automatikusan csatolhatod."/>
                    </StackPanel>

                    <Button
                            Style="{StaticResource GhostButton}"
                            Margin="644,0,0,0"
                            Command="{Binding SendFeedbackCommand}"
                            Content="Visszajelzés küldése" Grid.ColumnSpan="2"/>
                </Grid>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>

